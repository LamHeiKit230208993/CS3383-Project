@startuml
title Baseline J01-J04: database schema (generated by Hibernate into the H2 file)

hide circle
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 6
skinparam defaultFontSize 11
skinparam ArrowColor #37474F
skinparam DefaultFontColor #263238
skinparam EntityBackgroundColor #FFFFFF
skinparam EntityBorderColor #1565C0
skinparam EntityFontColor #263238
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #F9A825

entity "CATALOGUE" as CATALOGUE {
  * id : BIGINT <<PK>>
  --
  * imported_at : TIMESTAMP WITH TZ
  source_date : DATE {null = unknown}
  source_url : VARCHAR(255)
}

entity "PRODUCT" as PRODUCT {
  * code : VARCHAR(64) <<PK>>
  --
  name_en : VARCHAR(255)
  name_zh_hant : VARCHAR(255)
  name_zh_hans : VARCHAR(255)
  brand_en : VARCHAR(255)
  brand_zh_hant : VARCHAR(255)
  brand_zh_hans : VARCHAR(255)
  cat1_en / zh_hant / zh_hans : VARCHAR(255)
  cat2_en / zh_hant / zh_hans : VARCHAR(255)
  cat3_en / zh_hant / zh_hans : VARCHAR(255)
  catalogue_id : BIGINT <<FK>>
}

entity "LISTING" as LISTING {
  * id : BIGINT <<PK>>
  --
  * retailer_code : VARCHAR(32)
  price : NUMERIC(12) {null = unknown}
  offer_en : VARCHAR(255)
  offer_zh_hant : VARCHAR(255)
  offer_zh_hans : VARCHAR(255)
  * product_code : VARCHAR(64) <<FK>>
}

entity "SHOPPING_LIST" as LIST {
  * id : BIGINT <<PK>>
  --
  name : VARCHAR(255)
}

entity "LIST_ITEM" as ITEM {
  * product_code : VARCHAR(64) <<PK>>
  --
  list_id : BIGINT <<FK>>
  * quantity : INTEGER
  * checked : BOOLEAN
  * added_at : TIMESTAMP WITH TZ
}

CATALOGUE "1" ||--o{ PRODUCT : "catalogue_id"
PRODUCT "1" ||--o{ LISTING : "product_code"
LIST "1" ||--o{ ITEM : "list_id"
PRODUCT "1" ||--o{ ITEM : "product_code (no FK)"

note right of CATALOGUE
  Single row (id = 1) in this baseline.
  J02 replaces it in one transaction,
  so every import swaps the whole
  product set. source_date stays
  NULL because the JSON has no date.
end note

note right of LISTING
  price is NULL when the source has
  no usable amount. It is never 0.
  Offer text is stored per language
  and is not split into a unit price.
end note

note bottom of ITEM
  product_code is the primary key, so a
  product appears at most once per list
  and a repeat add increases quantity.
  There is no foreign key to PRODUCT:
  list rows are kept even if the product
  is missing from a newer catalogue.
  No price is copied into the list.
end note
@enduml
