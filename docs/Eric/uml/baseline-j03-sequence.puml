@startuml
title Baseline J03: search and compare

skinparam shadowing false
skinparam defaultFontSize 12
skinparam ArrowColor #37474F
skinparam DefaultFontColor #263238
skinparam ParticipantBackgroundColor #E3F2FD
skinparam ParticipantBorderColor #1565C0
skinparam SequenceLifeLineBorderColor #90A4AE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #F9A825
autonumber

actor "Household shopper" as Shopper
participant "Catalogue" as Catalogue
participant "Product" as Product
participant "Comparison" as Comparison

Shopper -> Catalogue : find(query, lang)
activate Catalogue
Catalogue --> Shopper : List<Product>\nstated pack via code
deactivate Catalogue

Shopper -> Product : compare()
activate Product
Product -> Comparison : create(product)
activate Comparison
loop every listing
  alt price is known
    Comparison -> Comparison : track cheapest, keep ties
  else price is null (unknown)
    Comparison -> Comparison : add retailer to missing
  end
end
Comparison --> Shopper : Comparison\ncheapest / ties / missing / importedAt
deactivate Comparison
deactivate Product
note over Comparison
  A null price is never treated as 0
  and can never win.
end note
@enduml
