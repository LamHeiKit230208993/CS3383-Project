@startuml
title Baseline J01-J04: import -> search -> compare -> add to list -> restart and reload

skinparam shadowing false
skinparam defaultFontSize 12
skinparam ArrowColor #37474F
skinparam DefaultFontColor #263238
skinparam ParticipantBackgroundColor #E3F2FD
skinparam ParticipantBorderColor #1565C0
skinparam SequenceLifeLineBorderColor #90A4AE
skinparam NoteBackgroundColor #FFF8E1
skinparam NoteBorderColor #F9A825

actor "Household shopper" as Shopper
participant "Catalogue" as Catalogue
participant "Product" as Product
participant "Comparison" as Comparison
participant "ShoppingList" as ShoppingList
participant "ListItem" as ListItem
database "H2 file store" as Store

== J01/J02 import ==

Shopper -> Catalogue : import sample, then daily JSON
activate Catalogue
Catalogue -> Catalogue : parse and validate\nmoney as decimal, retrieval time
alt valid and not empty
  Catalogue -> Catalogue : replace(products)\nkeyed by code
  Catalogue -> Store : save accepted catalogue
else invalid or empty
  Catalogue --> Shopper : keep last accepted catalogue
end
deactivate Catalogue

== J03 search and compare ==

Shopper -> Catalogue : find(query, lang)
activate Catalogue
Catalogue --> Shopper : List<Product>
deactivate Catalogue

Shopper -> Product : compare(listings)
activate Product
Product -> Comparison : create
activate Comparison
Comparison -> Comparison : cheapest, ties, missing\nmissing price never wins
Comparison --> Shopper : Comparison
deactivate Comparison
deactivate Product

== J04 add to list ==

Shopper -> ShoppingList : add(code, qty)
activate ShoppingList
ShoppingList -> ListItem : create(productCode, quantity)\nchecked = false
activate ListItem
ListItem --> ShoppingList : item
deactivate ListItem
ShoppingList -> Store : save shopping list
ShoppingList --> Shopper : updated list
deactivate ShoppingList

== restart, then reload ==

Shopper -> Store : open saved catalogue and list
Store --> Catalogue : accepted catalogue
Store --> ShoppingList : items with quantity, checked, addedAt
Shopper -> ShoppingList : toggle(code, checked)
activate ShoppingList
ShoppingList -> Store : save shopping list
deactivate ShoppingList
@enduml
