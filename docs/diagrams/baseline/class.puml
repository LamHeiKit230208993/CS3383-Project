!pragma layout elk
top to bottom direction
title Market Desk | persisted domain and service interfaces
class ProductEntity {
  code: String
  active: boolean
}
class LocalizedLabel <<embeddable>> {
  en: String
  zhHant: String
  zhHans: String
}
class RetailerListingEntity {
  retailerCode: String
  price: BigDecimal [nullable]
}
class OfferEntity {
  text: LocalizedLabel
}
class AcceptedImportEntity {
  origin: String
  retrievedAt: Instant
  sourceDate: LocalDate [nullable]
  checksum: String
}
class ShoppingListEntity {
  name: String
}
class ShoppingListItemEntity {
  quantity: int [1..999]
  checked: boolean
  selectedRetailerCode: String [nullable]
}
class CatalogService <<service>> {
  searchResults(query, category): SearchResults
  search(query): List<ProductView>
  find(code): ProductView
  status(): ImportStatus
  importSample(): ImportStatus
  refreshLive(): ImportStatus
}
class ShoppingService <<service>> {
  items(): List<ItemView>
  summary(): Summary
  add(code, quantity)
  add(code, quantity, retailerCode)
  update(code, quantity, checked)
  update(code, quantity, checked, retailerCode)
  remove(code)
}
ProductEntity "1" *-- "5" LocalizedLabel : name, brand, categories
ProductEntity "1" -- "0..*" RetailerListingEntity : current listings
RetailerListingEntity "1" *-- "0..*" OfferEntity : original text
ShoppingListEntity "1" *-- "0..*" ShoppingListItemEntity : contains
ShoppingListItemEntity "0..*" --> "1" ProductEntity : retained reference
CatalogService ..> ProductEntity : queries and imports
CatalogService ..> AcceptedImportEntity : replaces singleton status
ShoppingService ..> ShoppingListItemEntity : persists changes
class ProductView <<read model>> {
  from(product): ProductView
}
class Summary <<read model>> {
  from(items): Summary
}
ShoppingService ..> ProductView : maps loaded products
CatalogService ..> ProductView : maps loaded products
ShoppingService ..> Summary : derives totals
note bottom of AcceptedImportEntity
  One latest accepted import, not history.
  Failed import keeps accepted data.
end note
note bottom of ShoppingListItemEntity
  Current UI uses one My list.
  Checked does not mean purchased.
  Null retailer means automatic lowest.
  Unavailable explicit choice stays unknown.
end note
@enduml
