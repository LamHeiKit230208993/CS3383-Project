@startuml
' Official PlantUML; Print palette. Layout hints do not add model relationships.
top to bottom direction
skinparam backgroundColor #ffffff
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #111827
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #f3f4f6
skinparam classBorderColor #4b5563
skinparam arrowColor #4b5563
skinparam noteBackgroundColor #e5e7eb
skinparam noteBorderColor #4b5563
skinparam nodesep 35
skinparam ranksep 65
hide circle
hide empty methods

title Market Desk | persisted data model (J01-J08)

class ShoppingListEntity <<entity>> {
  - id: Long {PK}
  - name: String {unique, not null}
}
class ShoppingListItemEntity <<entity>> {
  - id: Long {PK}
  - quantity: int {not null}
  - checked: boolean {not null}
  - selectedRetailerCode: String {nullable}
}
class ProductEntity <<entity>> {
  - code: String {PK}
  - brand: LocalizedLabel {nullable}
  - name: LocalizedLabel {nullable}
  - category1: LocalizedLabel {nullable}
  - category2: LocalizedLabel {nullable}
  - category3: LocalizedLabel {nullable}
  - active: boolean {not null}
}
class RetailerListingEntity <<entity>> {
  - id: Long {PK}
  - retailerCode: String {not null}
  - price: BigDecimal {nullable}
}
class OfferEntity <<entity>> {
  - id: Long {PK}
  - text: LocalizedLabel {nullable}
}
class AcceptedImportEntity <<entity>> {
  - id: Long {PK}
  - origin: String {not null}
  - sourceUrl: String {not null}
  - retrievedAt: Instant {not null}
  - sourceDate: LocalDate {nullable}
  - checksum: String {not null}
  - productCount: int {not null}
  - listingCount: int {not null}
  - offerCount: int {not null}
}
class LocalizedLabel <<embedded value>> {
  - en: String {DB nullable}
  - zhHant: String {DB nullable}
  - zhHans: String {DB nullable}
  -- Language / JSON mapping --
  en = English
  zhHant = Traditional Chinese
  zhHans = Simplified Chinese
  JSON: en / zh-Hant / zh-Hans
}

' --- J05-J08 records. Keyed by product/retailer strings; NOT linked to listings. ---
class WishlistEntryEntity <<entity>> {
  - productCode: String {PK}
  - createdAt: Instant {not null}
}
class TrackingChoiceEntity <<entity>> {
  - id: Long {PK}
  - productCode: String {not null}
  - retailerCode: String {not null}
  - enabled: boolean {not null}
  - startedAt: Instant {not null}
}
class PriceObservationEntity <<entity>> {
  - id: Long {PK}
  - productCode: String {not null}
  - retailerCode: String {not null}
  - price: BigDecimal {nullable}
  - retrievedAt: Instant {not null}
  - checksum: String {not null}
  - offerSnapshot: String {nullable}
}
class AlertRuleEntity <<entity>> {
  - id: Long {PK}
  - productCode: String {not null}
  - retailerCode: String {not null}
  - type: TARGET|DROP {not null}
  - targetAmount: BigDecimal {nullable}
  - enabled: boolean {not null}
  - lastFiredObservationId: Long {nullable}
}
class AlertEventEntity <<entity>> {
  - id: Long {PK}
  - ruleId: Long {not null}
  - observationId: Long {not null}
  - productCode: String {not null}
  - retailerCode: String {not null}
  - ruleType: String {not null}
  - price: BigDecimal {nullable}
  - firedAt: Instant {not null}
  - acknowledged: boolean {not null}
  - snoozedUntil: Instant {nullable}
}
class BudgetSettingsEntity <<entity>> {
  - id: Long {PK = 1}
  - period: WEEKLY|MONTHLY {not null}
  - limitAmount: BigDecimal {not null}
}
class ReminderEntity <<entity>> {
  - id: Long {PK}
  - productCode: String {not null}
  - quantity: int {not null}
  - intervalDays: int {not null}
  - snoozeDays: int {not null}
  - nextDueAt: Instant {not null}
  - active: boolean {not null}
}

ShoppingListEntity "1" *-right- "0..*" ShoppingListItemEntity : items
ShoppingListItemEntity "0..*" -right-> "1" ProductEntity : product
ProductEntity "1" -right- "0..*" RetailerListingEntity : listings
ProductEntity "1" *-down- "0..5" LocalizedLabel : embeds
RetailerListingEntity "1" *-down- "0..*" OfferEntity : offers
OfferEntity "1" *-left- "0..1" LocalizedLabel

' Arrange the independent metadata record below the list; no foreign key implied.
ShoppingListEntity -[hidden]down-> AcceptedImportEntity
AcceptedImportEntity -[hidden]right-> LocalizedLabel

' History is separate from live listings; a replacement never deletes it.
AlertRuleEntity "1" -down-> "0..*" AlertEventEntity : fires
TrackingChoiceEntity ..> PriceObservationEntity : records on import
note right of PriceObservationEntity
  Observations are keyed by productCode + retailerCode strings,
  not foreign keys to retailer_listings. Catalogue replacement
  deletes listings/offers but this history remains (D02/D03).
  Unique: (productCode, retailerCode, checksum).
end note

legend bottom left
  |= Database constraints / persistence mapping |= Parser and service rules (not DB CHECK constraints) |
  | PKs and required list/product/listing foreign keys. | Quantity must be 1..999; checked state is not a purchase. |
  | Unique: list name; (list, product); (product, retailer). | One My list is used; accepted-import writes use ID 1. |
  | Price column: DECIMAL(19,4), nullable. | Reject negative prices and inputs needing decimal rounding. |
  | selectedRetailerCode is nullable and has no FK. | Null = lowest priced listing, if available; keep unavailable explicit choices. |
  | Language fields: nullable embedded columns, not a separate table. | Require all five product labels in three languages; offers may be blank. |
  | Diamonds: JPA-owned children or embedded values. | Keep inactive products for saved references; offers remain text. |
  | J05-J08 tables have no FK to listings or offers. | Track all priced retailers; keep history across replacement; unknown price = no observation. |
endlegend
@enduml
