!pragma layout elk
left to right direction
title Market Desk | J01–J04 shopper goals
actor Shopper as shopper
actor "Consumer Council\nprice provider" as provider
rectangle "Local Market Desk app" {
  usecase "Load checked\nhistorical sample" as sample
  usecase "Refresh live\ncatalogue" as refresh
  usecase "Search stored\nsource labels" as search
  usecase "Compare exact product\nand retailer listings" as compare
  usecase "Manage saved My list\nquantity and checked state" as manage
  usecase "Read saved list\nafter app restart" as reload
}
shopper -- sample
shopper -- refresh
shopper -- search
shopper -- compare
shopper -- manage
shopper -- reload
provider -- refresh
note bottom of manage
  One user; no account or cloud.
  Unknown prices stay unknown.
end note
@enduml
