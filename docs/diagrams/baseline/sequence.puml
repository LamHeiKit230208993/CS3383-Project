@startuml
skinparam backgroundColor #ffffff
skinparam defaultFontName Arial
skinparam defaultFontColor #111827
skinparam defaultFontSize 13
skinparam arrowColor #4b5563
skinparam participantBackgroundColor #f3f4f6
skinparam participantBorderColor #4b5563
skinparam noteBackgroundColor #e5e7eb
skinparam noteBorderColor #4b5563
skinparam shadowing false
title Market Desk | import, compare, save, reopen (J01-J08)

actor Shopper as shopper
participant "HelloController" as web
participant "CatalogService" as catalog
participant "Consumer Council JSON\n(via source client)" as source
participant "CatalogJsonParser" as parser
participant "CatalogReplacementService" as replace
participant "ShoppingService" as shopping
participant "ObservationRecorder" as recorder
participant "AlertService" as alerts
participant "ReminderService" as reminders
participant "Clock (Asia/Hong_Kong)" as clock
database "H2 file" as db

== Accept catalogue ==
alt Load checked sample
  shopper -> web: POST /data/sample\n(confirm when replacing accepted data)
  web -> catalog: importSample()
else Refresh live prices
  shopper -> web: POST /data/refresh
  web -> catalog: refreshLive()
  catalog -> source: fetch()\n(fixed endpoint via source client)
  alt Fetch fails
    break Do not parse or replace
      source --> catalog: HTTP, timeout, or size error
      catalog --> web: exception
      web --> shopper: error; prior data kept
    end
  else Fetch succeeds
    source --> catalog: JSON bytes
  end
end
catalog -> parser: parse(bytes)
alt Parser rejects input
  break Do not replace invalid input
    parser --> catalog: CatalogImportException
    catalog --> web: exception
    web --> shopper: import error
  end
else Validated input
  parser --> catalog: ImportedCatalog
end

catalog -> replace: replace(parsed, origin, sourceUrl,\nretrievedAt, checksum)
group Atomic replacement [@Transactional on replacement service]
  note over replace, db: Repository and transaction-manager calls are folded into H2.
  alt A repository write or commit fails
    replace -> db: attempt replacement writes
    db --> replace: persistence error
    replace -> db: ROLLBACK (Spring)
    db --> replace: prior accepted data retained
  else All writes and commit succeed
    replace -> db: replace catalogue, listings, offers,\nmetadata (sourceDate = null)
    replace -> db: COMMIT (Spring)
    db --> replace: committed
  end
end
break Replacement failed
  replace --> catalog: exception after rollback
  catalog --> web: import error
  web --> shopper: redirect; prior catalogue and list kept
end
replace --> catalog: ImportStatus after commit
note over catalog, recorder
  History recording runs only after the replacement has committed.
  A recording failure is reported, never rolls back the accepted data
  (the accepted import stays and history retries on the next import).
end note
catalog -> recorder: recordAfterImport(retrievedAt, checksum)
group Separate transaction
  recorder -> db: read enabled tracking choices
  db --> recorder: tracked (product, retailer) pairs
  recorder -> db: insert one observation per priced pair
  db --> recorder: saved (unique per checksum)
end
recorder --> catalog: warning or null
catalog -> alerts: evaluateAll()
alerts -> db: read observations and rules; save new events
db --> alerts: events
alerts --> catalog: done (failure is logged, not fatal)
catalog --> web: accepted import status
web --> shopper: success notice (plus any history warning)

== Record price and show an alert ==
shopper -> web: GET /alerts
web -> alerts: view()
alerts -> clock: instant() / isQuietHours()
clock --> alerts: Hong Kong time
alerts -> db: read rules and events
db --> alerts: rules; events (visible/hidden, snoozed)
alerts --> web: AlertPageView (quiet hours, events, summary)
web --> shopper: in-app alerts; closed-app periods are not delivered alerts

== Search and compare ==
shopper -> web: GET /?q=...&category=...
web -> catalog: searchResults(query, category)
catalog -> db: read active catalogue
db --> catalog: active product records
catalog -> catalog: filter and rank source labels
catalog --> web: Matches, Related, categories
web --> shopper: results; Matches is default
shopper -> web: GET /products/{code}
web -> catalog: find(code)
catalog -> db: fetch exact product and retailer data
db --> catalog: product, listings, source offers
catalog --> web: comparison with tied lowest prices
web --> shopper: exact product; offers are not calculated

== Choose and save ==
shopper -> web: POST /list/items\n(code, quantity, retailerCode)
web -> shopping: add(code, quantity, retailerCode)\n(blank retailerCode = Automatic lowest)
shopping -> shopping: validate quantity
shopping -> db: read product and saved item\n(listings for an explicit choice)
db --> shopping: product and saved choice data
shopping -> shopping: check product and requested choice
shopping -> db: save quantity, checked, selectedRetailerCode
db --> shopping: saved item
shopping --> web: saved
web --> shopper: redirect to My list

== Restart and reload ==
note over shopper, db
  Stop and restart the app. Reuse the H2 file;
  startup makes no network request.
end note
shopper -> web: GET /list (after restart)
web -> shopping: items()
shopping -> db: read saved items and current prices
db --> shopping: quantity, checked,\nselected retailer code
shopping --> web: saved items with effective prices
web -> web: Summary.from(items)
web --> shopper: My list and known subtotal
note over shopping, db: Explicit retailer choice persists; unavailable prices remain unknown.

== Reminder adds to list ==
shopper -> web: POST /reminders/{id}/add-to-list
web -> reminders: addToList(id)
reminders -> db: read reminder (product, quantity)
db --> reminders: reminder
reminders -> shopping: add(productCode, quantity)
note over reminders, shopping
  Reuses J04 rules: quantity 1..999 and the existing-item/
  other-retailer conflict. It does not change reminder state (D07).
end note
shopping --> reminders: saved or conflict error
reminders --> web: result
web --> shopper: redirect to Reminders
@enduml
