# Copy to .env and fill in your own values. The .env file is git-ignored.
PRICEWATCH_AI_BASE_URL=https://llm.cs.cityu.edu.hk/v1
PRICEWATCH_AI_API_KEY=your-key-here
PRICEWATCH_AI_MODEL=CS3383/DeepSeek-V4-Flash

# Optional: let a phone on the same Wi-Fi open the app. Also start with
# --server.address=0.0.0.0. List this computer's LAN address(es) to accept them.
# PRICEWATCH_ALLOWED_HOSTS=192.168.1.20
